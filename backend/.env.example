# Các biến môi trường cho Backend (sao chép file này thành .env khi phát triển cục bộ)

# Chế độ chạy ứng dụng: development | production
APP_ENV=development

# Khóa ký token JWT (BẮT BUỘC đổi ở môi trường production)
# Hãy sử dụng một chuỗi ngẫu nhiên dài, ít nhất 32 ký tự.
JWT_SECRET_KEY=change-this-secret-before-deploy

# Cấu hình CORS (Cho phép chia sẻ tài nguyên giữa các nguồn khác nhau)
CORS_ALLOW_ALL=0
CORS_ORIGINS=http://localhost:5173

# Cấu hình Google Sign-In (Xác thực id_token nhận được)
# ID này phải trùng khớp với VITE_GOOGLE_CLIENT_ID ở frontend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI_FLUTTER=http://localhost:8000/api/auth/google/callback/flutter

# URL Frontend dùng để điều hướng sau khi Google OAuth callback thành công
FRONTEND_URL=http://localhost:5173

# Cấu hình cổng thanh toán SePay
SEPAY_API_KEY="paste_api_key_here"
NAME_WEB="W2L"
SECRET_XOR_KEY=0x5EAFB

# Tài khoản Admin mặc định (Tự động khởi tạo khi chạy lần đầu nếu chưa tồn tại)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@word2latex.local
ADMIN_PASSWORD=Admin@123456
