# Các biến môi trường cho Frontend (sao chép file này thành .env và điền thông tin của bạn)

# Client ID đăng nhập bằng Google
VITE_GOOGLE_CLIENT_ID=

# URL API của Backend (Mặc định khi chạy cục bộ là http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# Cấu hình tài khoản ngân hàng thụ hưởng nhận tiền nạp Token (hiển thị mã VietQR)
# Tra mã BIN ngân hàng tại: https://api.vietqr.io/v2/banks
VITE_BANK_BIN=970422
VITE_BANK_ACCOUNT=0123456789
VITE_BANK_ACCOUNT_NAME=TRAN TAN DAT